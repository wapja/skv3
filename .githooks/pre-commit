#!/usr/bin/env bash
# Fast checks on staged PHP files (< 10 s). The full suite runs in CI (composer check).
# File names travel NUL-separated (-z, xargs -0), so names with spaces or quotes are passed intact.
set -euo pipefail

staged=()
while IFS= read -r -d '' file; do
    case "$file" in
        *.blade.php) ;;
        *) staged+=("$file") ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.php')

[ "${#staged[@]}" -eq 0 ] && exit 0

# The tools read the working tree: refuse staged files with unstaged changes, so what is checked is what is committed.
partial=()
while IFS= read -r -d '' file; do
    for candidate in "${staged[@]}"; do
        if [ "$file" = "$candidate" ]; then
            partial+=("$file")
            break
        fi
    done
done < <(git diff --name-only -z)

if [ "${#partial[@]}" -gt 0 ]; then
    echo "pre-commit: stage or stash the unstaged changes in:" >&2
    printf '  %s\n' "${partial[@]}" >&2
    exit 1
fi

printf '%s\0' "${staged[@]}" | xargs -0 vendor/bin/pint --test --
printf '%s\0' "${staged[@]}" | xargs -0 vendor/bin/phpstan analyse --no-progress --memory-limit=1G --
