{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(php artisan test:*)",
            "Bash(php artisan route:list:*)",
            "Bash(php artisan config:show:*)",
            "Bash(php artisan about:*)",
            "Bash(php artisan view:clear:*)",
            "Bash(php artisan config:clear:*)",
            "Bash(php artisan boost:update:*)",
            "Bash(php artisan list:*)",
            "Bash(php artisan dev:list:*)",
            "Bash(composer check)",
            "Bash(composer fix)",
            "Bash(composer test:pgsql)",
            "Bash(composer test:browser)",
            "Bash(composer doctor)",
            "Bash(composer install:*)",
            "Bash(composer show:*)",
            "Bash(vendor/bin/pest:*)",
            "Bash(vendor/bin/pint:*)",
            "Bash(vendor/bin/rector:*)",
            "Bash(vendor/bin/phpstan:*)",
            "Bash(npm run build)",
            "Bash(npm run build:setup)",
            "Bash(npm ci)",
            "Bash(git status)",
            "Bash(git diff:*)",
            "Bash(git log:*)"
        ],
        "deny": [
            "Bash(herd sites:*)",
            "Bash(php artisan migrate:fresh:*)",
            "Bash(php artisan db:wipe:*)",
            "Bash(php artisan migrate:reset:*)",
            "Bash(php artisan migrate:refresh:*)",
            "Bash(php artisan migrate:rollback:*)",
            "mcp__herd__get_all_sites",
            "mcp__herd__get_site_information",
            "mcp__herd__get_forge_environment_variables",
            "mcp__herd__get_last_deployment_information",
            "mcp__herd__find_available_services",
            "mcp__herd__start_debug_session",
            "mcp__herd__stop_debug_session",
            "Read(./.env)",
            "Read(./.env.testing)",
            "Read(./.env.backup)",
            "Read(./.env.production)",
            "Read(./.env.local)"
        ],
        "ask": [
            "mcp__herd__install_service",
            "mcp__herd__start_or_stop_service",
            "mcp__herd__install_php_version",
            "mcp__herd__secure_or_unsecure_site",
            "mcp__herd__isolate_or_unisolate_site"
        ]
    },
    "enabledMcpjsonServers": [
        "laravel-boost",
        "herd"
    ],
    "enabledPlugins": {
        "superpowers@superpowers-marketplace": true
    },
    "extraKnownMarketplaces": {
        "superpowers-marketplace": {
            "source": {
                "source": "github",
                "repo": "obra/superpowers-marketplace"
            }
        }
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "f=$(php -r '$i=json_decode(stream_get_contents(STDIN),true); echo $i[\"tool_input\"][\"file_path\"] ?? \"\";'); case \"$f\" in *.blade.php) ;; *.php) \"$CLAUDE_PROJECT_DIR\"/vendor/bin/pint \"$f\" >/dev/null 2>&1 ;; esac; exit 0"
                    }
                ]
            }
        ]
    }
}
