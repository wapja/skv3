APP_NAME=Laravel
BRANDING_ACCENT=
BRANDING_LOGO=
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Setup writes a random 40-character key; /health-check (M7) answers 403 while it is blank.
HEALTH_CHECK_KEY=
# The cache store for the health report, its throttle and the scheduler heartbeat (CD-5); on several servers use a shared store such as redis.
OPS_CACHE_STORE=file

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_NL

# Tenancy: {slug}.{apex} are organisations; {apex} and admin.{apex} are central.
# Leave TENANCY_APEX_DOMAIN empty to use the APP_URL host.
TENANCY_APEX_DOMAIN=
TENANCY_ADMIN_SUBDOMAIN=admin
TENANCY_STRICT=true

# Invitations: days until an invitation link expires (a reminder renews it).
INVITATION_EXPIRES_IN_DAYS=7

# Optional modules.
MODULE_PASSKEYS=true
MODULE_IMPERSONATION=true
MODULE_BACKUPS=true
# Backups (module, PostgreSQL only, §4.9): setup writes a random archive password. Keep a copy outside the server,
# because without it no archive can be opened. Failures mail BACKUP_NOTIFY_EMAIL (blank: MAIL_FROM_ADDRESS).
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFY_EMAIL=
# The directory holding pg_dump; blank finds it on PATH or in Herd's PostgreSQL services.
PG_DUMP_BINARY_PATH=

# Passkeys use the apex as relying party id; set this only if it must differ.
PASSKEYS_RELYING_PARTY_ID=

# Behind a load balancer or CDN: its addresses (comma-separated, or * for the calling proxy),
# so rate limits see each visitor's IP. Leave empty when visitors reach the app directly.
TRUSTED_PROXIES=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Minimum duration of a sign-in attempt in microseconds; keep it above one password hash check.
AUTH_TIMEBOX_DURATION=500000

# Audit log entries older than this many days are removed by activitylog:clean.
ACTIVITYLOG_RETENTION_DAYS=365

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=app_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
